    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongodb": "~6.20.0",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "openai": "^4.0.0",
    "shared": "*",
    "simple-git": "^3.36.0",
    "svix": "^1.99.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
