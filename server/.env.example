# Server
NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Clerk (Backend)
# Found in Clerk Dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Webhooks -> found in Clerk Dashboard -> Webhooks -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# AI provider (Phase 2 — chat)
# Switching AI_PROVIDER later (e.g. to "anthropic") requires implementing that
# provider under src/services/ai/providers/, no frontend changes needed.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional — point the OpenAI SDK at any OpenAI-API-compatible provider instead of the real
# OpenAI API (e.g. OpenRouter). Leave blank to use the real OpenAI API.
# For OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1, and OPENAI_API_KEY=<your sk-or-... key>
OPENAI_BASE_URL=

# AI chat rate limiting (per signed-in user)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=10

# Planner Agent (Phase 5)
MAX_PLANNER_RETRIES=2
PLANNER_RATE_LIMIT_WINDOW_MS=600000
PLANNER_RATE_LIMIT_MAX_REQUESTS=5

# Frontend Agent (Phase 6)
# Falls back to AI_MODEL if unset
FRONTEND_AGENT_MODEL=
MAX_CODEGEN_RETRIES=2
MAX_CONTEXT_TOKENS=12000
MAX_FILE_CONTEXT_SIZE=20000
MAX_GENERATION_TOKENS=4000
# Must stay "false" — changes always require explicit user approval regardless of this flag
AI_AUTO_APPLY=false
MAX_FILES_PER_OPERATION=50
MAX_TASK_OPERATIONS=100
MAX_TOTAL_OPERATION_SIZE=20971520
FRONTEND_AGENT_RATE_LIMIT_WINDOW_MS=600000
FRONTEND_AGENT_RATE_LIMIT_MAX_REQUESTS=5

# Backend Agent (Phase 7)
# Falls back to AI_MODEL if unset. Reuses every other Frontend Agent limit above
# (MAX_CODEGEN_RETRIES, MAX_CONTEXT_TOKENS, MAX_FILE_CONTEXT_SIZE, MAX_GENERATION_TOKENS,
# MAX_FILES_PER_OPERATION, MAX_TASK_OPERATIONS, MAX_TOTAL_OPERATION_SIZE) and the same
# FRONTEND_AGENT_RATE_LIMIT_* budget — task execution/regeneration is rate-limited per user,
# regardless of which agent ends up handling the task.
BACKEND_AGENT_MODEL=

# Database Agent (Phase 8) — same reuse pattern as the Backend Agent above.
DATABASE_AGENT_MODEL=

# Testing Agent (Phase 9)
# Falls back to AI_MODEL if unset. Reuses every codegen limit above; these are sandbox-execution-only.
TESTING_AGENT_MODEL=
TEST_RUN_TIMEOUT_MS=120000
TEST_INSTALL_TIMEOUT_MS=180000
TEST_RUN_MAX_OUTPUT_CHARS=20000
TESTING_AGENT_RATE_LIMIT_WINDOW_MS=600000
TESTING_AGENT_RATE_LIMIT_MAX_REQUESTS=5
TEST_RUN_RATE_LIMIT_WINDOW_MS=600000
TEST_RUN_RATE_LIMIT_MAX_REQUESTS=5

# Multi-Agent Orchestrator (Phase 10)
MAX_CONCURRENT_AGENTS=3
ORCHESTRATOR_MAX_RETRIES=2
ORCHESTRATOR_MAX_FIX_CYCLES=3
ORCHESTRATOR_TASK_TIMEOUT_MS=600000
ORCHESTRATOR_RATE_LIMIT_WINDOW_MS=600000
ORCHESTRATOR_RATE_LIMIT_MAX_REQUESTS=5

# Secure Terminal + Sandbox Execution (Phase 11) — requires Docker Desktop/Engine running locally.
SANDBOX_IMAGE_TAG=mingo-sandbox:node22-v1
SANDBOX_MEMORY_MB=1024
# Cap for the /tmp tmpfs (npm cache + $HOME) — separate from SANDBOX_MEMORY_MB. Too small and a real
# `npm install` fails with ENOSPC even though /workspace itself has plenty of disk.
SANDBOX_TMPFS_MB=512
SANDBOX_CPU_CORES=1.5
SANDBOX_PIDS_LIMIT=256
SANDBOX_DISK_LIMIT_MB=2048
SANDBOX_TIMEOUT_MS=300000
SANDBOX_INSTALL_TIMEOUT_MS=180000
SANDBOX_MAX_LOG_CHARS=200000
SANDBOX_ORPHAN_SWEEP_INTERVAL_MS=300000
SANDBOX_RATE_LIMIT_WINDOW_MS=600000
SANDBOX_RATE_LIMIT_MAX_REQUESTS=20
